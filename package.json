{
  "name": "@priyanshu2007-cmd/bisectpilot",
  "version": "0.1.0",
  "description": "Local-first, evidence-first Git regression bisection engine and CLI",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priyanshu2007-cmd/BisectPilot-.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "bisectpilot": "./dist/src/index.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./contracts": {
      "types": "./dist/src/contracts/index.d.ts",
      "default": "./dist/src/contracts/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node scripts/run-tests.mjs",
    "test:unit": "tsc -p tsconfig.json && node scripts/run-tests.mjs unit",
    "test:integration": "tsc -p tsconfig.json && node scripts/run-tests.mjs integration",
    "test:safety": "tsc -p tsconfig.json && node scripts/run-tests.mjs safety",
    "test:py": "PYTHONPATH=src python3 -m unittest discover -s tests -v"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
