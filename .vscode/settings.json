{
  "explorer.compactFolders": false,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "AI_BRAIN.md": "AI_RULES.md, SESSION_MEMORY.md, ANTIGRAVITY_MASTER_PROMPT.txt, SPEC.md",
    "AGENTS.md": "CLAUDE.md, GEMINI.md, .mcp.json, opencode.json",
    "pyproject.toml": "uv.lock, .python-version",
    ".gitignore": ".ignore, .env.example, .nvmrc",
    "package.json": "package-lock.json, tsconfig.json, next-env.d.ts, next.config.*, postcss.config.*, eslint.config.*, Dockerfile, .dockerignore, Makefile, .nvmrc, .env.example"
  },
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.venv": true,
    "**/node_modules": true,
    "**/.next": true,
    "**/*.tsbuildinfo": true,
    ".{agent,agents,claude,kilo,opencode}": true,
    "ai-agent-toolkit": true,
    "graft": true,
    "skills*": true,
    "tasks": true,
    "is-website-vulnerable": true,
    "VibeSec-Skill": true
  },
  "search.exclude": {
    "**/dist": true,
    "**/build": true,
    "**/out": true,
    "**/coverage": true,
    "**/*.lock": true,
    "**/package-lock.json": true
  },
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/.next/**": true,
    ".{agent,agents,claude,kilo,opencode}/**": true,
    "ai-agent-toolkit/**": true,
    "graft/**": true,
    "skills*/**": true,
    "is-website-vulnerable/**": true,
    "VibeSec-Skill/**": true
  }
}
